{
  "name": "safai-safari-extension",
  "version": "0.2.0",
  "safariBuildNumber": 10,
  "private": true,
  "type": "module",
  "description": "A privacy-conscious AI side panel for Safari.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamie950315/SafAI.git"
  },
  "homepage": "https://github.com/jamie950315/SafAI#readme",
  "bugs": {
    "url": "https://github.com/jamie950315/SafAI/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:relay": "node scripts/build-relay.mjs",
    "relay:preview": "npm run build:relay && node scripts/run-relay.mjs",
    "package:safari": "npm run build && node scripts/package-safari.mjs",
    "archive:safari": "node scripts/archive-safari.mjs",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "check": "npm test && npm run build"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "katex": "^0.18.1",
    "markdown-it": "^14.3.0"
  }
}
